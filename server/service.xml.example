<!-- Put a trusted WinSW executable and this file (same basename) in the project root.
     Installation is performed by the Windows Server administrator, not by the app. -->
<service>
  <id>MilitaryAffairsServer</id>
  <name>Military Affairs LAN Server</name>
  <description>Central HTTPS service for approved military affairs desktop clients</description>
  <executable>%ProgramFiles%\nodejs\node.exe</executable>
  <arguments>--env-file=".env" server/start.cjs</arguments>
  <workingdirectory>%BASE%</workingdirectory>
  <startmode>Automatic</startmode>
  <serviceaccount>
    <domain>NT AUTHORITY</domain>
    <user>LocalService</user>
  </serviceaccount>
  <logpath>%BASE%\logs</logpath>
  <log mode="roll" />
  <onfailure action="restart" delay="10 sec" />
</service>
