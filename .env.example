# Copy to .env on the server. Never distribute .env with the desktop client.
DATABASE_URL=postgresql://military_app:CHANGE_ME@127.0.0.1:5432/military_affairs
HOST=127.0.0.1
PORT=8443
SERVER_ID=CHANGE_TO_A_UNIQUE_UUID
LICENSE_PUBLIC_KEY=private/issuer-public.pem
LICENSE_FILE=private/license.json
TLS_CERT=private/server-cert.pem
TLS_KEY=private/server-key.pem
# Initial administrator is created by server:init only, not automatically on startup.
ADMIN_USERNAME=admin
ADMIN_NAME=مسؤول النظام
ADMIN_PASSWORD=CHANGE_TO_A_LONG_UNIQUE_PASSWORD
# Generate once, keep a separate protected copy; loss of this key prevents restoring backups.
BACKUP_KEY_HEX=CHANGE_TO_64_RANDOM_HEX_CHARACTERS
BACKUP_DIRECTORY=C:/ProgramData/MilitaryAffairs/backups
BACKUP_RETENTION_DAYS=30
